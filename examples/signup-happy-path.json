{
  "name": "signup-happy-path",
  "description": "Sign a user in, read the page back, and loop over the result rows.",
  "variables": {
    "base": "https://example.com",
    "username": "ada"
  },
  "steps": [
    { "type": "web", "action": "goto", "url": "${base}/login" },
    { "type": "web", "action": "type", "target": { "strict": "#username" }, "text": "${username}" },
    { "type": "web", "action": "type", "target": { "strict": "#password" }, "text": "${secret.LOGIN}" },
    {
      "type": "web",
      "action": "click",
      "target": {
        "fuzzy": { "tag": "BUTTON", "attributes": { "aaname": "Sign in" }, "threshold": 0.8 },
        "anchor": { "target": { "strict": "label[for='password']" }, "relation": "below" }
      },
      "retry": 2,
      "retryDelayMs": 500
    },
    { "type": "web", "action": "waitForElement", "target": { "strict": "[data-testid='account-menu']" } },
    { "type": "web", "action": "getText", "target": { "strict": "[data-testid='account-menu']" }, "saveAs": "account" },
    { "type": "web", "action": "getText", "target": { "strict": "#orders" }, "saveAs": "ordersJson" },
    { "type": "api", "action": "request", "method": "GET", "url": "${base}/api/orders", "saveAs": "orders", "assertStatus": 200 },
    {
      "type": "control",
      "action": "foreach",
      "items": "${orders}",
      "itemName": "order",
      "steps": [
        { "type": "control", "action": "log", "message": "order: ${order}" }
      ]
    },
    {
      "type": "web",
      "action": "elementExists",
      "selector": "#toast-error",
      "saveAs": "toastError",
      "continueOnError": true
    },
    {
      "type": "control",
      "action": "if",
      "condition": "${toastError} == true",
      "then": [{ "type": "web", "action": "screenshot", "path": "runs/last/error-toast.png" }],
      "else": [{ "type": "control", "action": "log", "message": "no error toast" }]
    }
  ]
}
