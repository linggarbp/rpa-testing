{
  "name": "nutjs-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nutjs-testing — a desktop automation toolkit: JSON workflows, a step engine that drives the real screen through pluggable backends, a local Studio, and a robot client for an orchestrator.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "rpa": "dist/cli.js"
  },
  "scripts": {
    "rpa": "tsx src/cli.ts",
    "ui": "tsx src/ui/server.ts",
    "build": "tsc",
    "test": "npm run test:types && npm run test:node",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:node": "node --import tsx --test test/*.test.ts",
    "test:jest": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:vitest": "vitest run",
    "test:runners": "npm run test:jest && npm run test:vitest",
    "test:all": "npm test && npm run test:runners"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "playwright": "^1.64.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/node": "^24.19.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "imapflow": "^2.5.2",
    "nodemailer": "^10.1.2"
  }
}
